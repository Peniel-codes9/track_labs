<h1>Catalogue</h1>

<form action="/" method="GET" class="search-form">
  <input type="text" name="search" placeholder="Search title or author" value="<%= query.search || '' %>">
  <select name="genre">
    <option value="">All genres</option>
    <% genres.forEach(function (g) { %>
      <option value="<%= g %>" <%= query.genre === g ? 'selected' : '' %>><%= g %></option>
    <% }) %>
  </select>
  <button type="submit">Search</button>
</form>

<% if (books.length === 0) { %>
  <p class="empty-state">No books match your search.</p>
<% } else { %>
  <ul class="book-list">
    <% books.forEach(function (book) { %>
      <li>
        <a href="/books/<%= book._id %>"><%= book.title %></a>
        by <%= book.author %>
        <span class="badge"><%= book.copiesAvailable %>/<%= book.copiesTotal %> available</span>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../../partials/pagination') %>
